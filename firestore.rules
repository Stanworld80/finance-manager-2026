rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow collection group queries
    match /{path=**}/transactions/{txId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
    match /{path=**}/virtual_accounts/{vAccountId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // User Profiles
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Projects (Root level)
    match /projects/{projectId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Real Accounts
    match /accounts/{accountId} {
      
      // Allow read if user is in accessibleUserIds OR is owner
      allow read: if request.auth != null && 
                  (request.auth.uid == resource.data.ownerId || 
                   ('accessibleUserIds' in resource.data && request.auth.uid in resource.data.accessibleUserIds));
                  
      // Allow create if user sets themselves as owner
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      
      // Allow update if user is in accessibleUserIds OR is owner
      allow update: if request.auth != null && 
                    (request.auth.uid == resource.data.ownerId || 
                     ('accessibleUserIds' in resource.data && request.auth.uid in resource.data.accessibleUserIds));
                     
      // Allow delete if user is owner
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
                  
      // Nested Virtual Accounts
      match /virtual_accounts/{vAccountId} {
        function isParentAccessible() {
          let parentData = get(/databases/$(database)/documents/accounts/$(accountId)).data;
          return ('accessibleUserIds' in parentData && request.auth.uid in parentData.accessibleUserIds) ||
                 (parentData.ownerId == request.auth.uid);
        }
        
        allow read: if request.auth != null && 
                    (resource.data.userId == request.auth.uid || isParentAccessible());
                    
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        
        allow update, delete: if request.auth != null && 
                    (resource.data.userId == request.auth.uid || isParentAccessible());
      }
      
      // Nested Transactions
      match /transactions/{txId} {
        function isParentAccessible() {
          let parentData = get(/databases/$(database)/documents/accounts/$(accountId)).data;
          return ('accessibleUserIds' in parentData && request.auth.uid in parentData.accessibleUserIds) ||
                 (parentData.ownerId == request.auth.uid);
        }

        allow read: if request.auth != null && 
                    (resource.data.ownerId == request.auth.uid || isParentAccessible());
                    
        allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
        
        allow update, delete: if request.auth != null && 
                     (resource.data.ownerId == request.auth.uid || isParentAccessible());
      }
    }
  }
}
