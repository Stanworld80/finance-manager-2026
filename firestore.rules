rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Legacy generic rule just in case (for old data before migration)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Projects (Root level)
    match /projects/{projectId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Real Accounts
    match /real_accounts/{accountId} {
      // Basic rule: Allow read if user is owner or in shared list
      allow read: if request.auth != null && 
                 (resource.data.ownerId == request.auth.uid || 
                  request.auth.uid in resource.data.sharedWithUserIds);
      // Allow write if owner (can be expanded later for shared editors)
      allow write: if request.auth != null && 
                  (request.resource.data.ownerId == request.auth.uid);
                  
      // Nested Virtual Accounts
      match /virtual_accounts/{vAccountId} {
        allow read: if request.auth != null && resource.data.userId == request.auth.uid;
        allow write: if request.auth != null && request.resource.data.userId == request.auth.uid;
      }
      
      // Nested Transactions
      match /transactions/{txId} {
        allow read, write: if request.auth != null; // Simplified: assumes if you can hit the parent real account, you can read transactions. Stronger rule needed if shared editors differ.
      }
    }
  }
}
