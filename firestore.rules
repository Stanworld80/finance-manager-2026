rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Legacy generic rule just in case (for old data before migration)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Projects (Root level)
    match /projects/{projectId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Real Accounts
    match /accounts/{accountId} {
      
      // Allow read if user is in accessibleUserIds
      allow read: if request.auth != null && 
                  (request.auth.uid in resource.data.accessibleUserIds);
                  
      // Allow create if user sets themselves as owner
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      
      // Allow update if user is in accessibleUserIds OR is owner
      allow update: if request.auth != null && 
                    (request.auth.uid == resource.data.ownerId || 
                     request.auth.uid in resource.data.accessibleUserIds);
                     
      // Allow delete if user is owner
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
                  
      // Nested Virtual Accounts
      match /virtual_accounts/{vAccountId} {
        function isParentAccessible() {
          return request.auth.uid in get(/databases/$(database)/documents/accounts/$(accountId)).data.accessibleUserIds;
        }
        
        allow read: if request.auth != null && 
                    (resource.data.userId == request.auth.uid || isParentAccessible());
                    
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        
        allow update, delete: if request.auth != null && 
                    (resource.data.userId == request.auth.uid || isParentAccessible());
      }
      
      // Nested Transactions
      match /transactions/{txId} {
        function isParentAccessible() {
          return request.auth.uid in get(/databases/$(database)/documents/accounts/$(accountId)).data.accessibleUserIds;
        }

        allow read: if request.auth != null && 
                    (resource.data.ownerId == request.auth.uid || isParentAccessible());
                    
        allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
        
        allow update, delete: if request.auth != null && 
                     (resource.data.ownerId == request.auth.uid || isParentAccessible());
      }
    }
  }
}
