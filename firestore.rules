rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Legacy generic rule just in case (for old data before migration)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Projects (Root level)
    match /projects/{projectId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Real Accounts
    match /accounts/{accountId} {
      // Allow read if user is in accessibleUserIds
      allow read: if request.auth != null && 
                  (request.auth.uid in resource.data.accessibleUserIds);
      // Allow write if user is owner or in accessibleUserIds (for shared editors)
      allow write: if request.auth != null && 
                   (request.resource.data.ownerId == request.auth.uid || 
                    request.auth.uid in get(/databases/$(database)/documents/accounts/$(accountId)).data.accessibleUserIds);
                  
      // Nested Virtual Accounts
      match /virtual_accounts/{vAccountId} {
        // Allow read if querying collectionGroup by userId, OR if user has access to parent account
        allow read: if request.auth != null && 
                    (resource.data.userId == request.auth.uid || 
                     request.auth.uid in get(/databases/$(database)/documents/accounts/$(accountId)).data.accessibleUserIds);
        allow write: if request.auth != null && 
                     (request.resource.data.userId == request.auth.uid || 
                      request.auth.uid in get(/databases/$(database)/documents/accounts/$(accountId)).data.accessibleUserIds);
      }
      
      // Nested Transactions
      match /transactions/{txId} {
        // Allow read if querying collectionGroup by ownerId, OR if user has access to parent account
        allow read: if request.auth != null && 
                    (resource.data.ownerId == request.auth.uid || 
                     request.auth.uid in get(/databases/$(database)/documents/accounts/$(accountId)).data.accessibleUserIds);
        allow write: if request.auth != null && 
                     (request.resource.data.ownerId == request.auth.uid || 
                      request.auth.uid in get(/databases/$(database)/documents/accounts/$(accountId)).data.accessibleUserIds);
      }
    }
  }
}
