{
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(wasm|js|css|png|jpg|jpeg|gif|webp|svg|ico|woff|woff2|ttf|eot|otf)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000, public"
          }
        ]
      },
      {
        "source": "index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "flutter_service_worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "finance-manager-2026",
          "appId": "1:599792752048:android:0c9d7449fce60754c07275",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options_dev.dart": {
          "projectId": "finance-manager-2026-dev",
          "configurations": {
            "android": "1:549484887171:android:79d75ab3e8fd67cbee6fb6",
            "web": "1:549484887171:web:2c2b138e4f6388fdee6fb6"
          }
        },
        "lib/firebase_options_stg.dart": {
          "projectId": "finance-manager-2026-stg",
          "configurations": {
            "android": "1:420654277416:android:4b750e6abdb68a7150661d",
            "web": "1:420654277416:web:05b73beebdf0ff0d50661d"
          }
        },
        "lib/firebase_options_prod.dart": {
          "projectId": "finance-manager-2026",
          "configurations": {
            "android": "1:599792752048:android:0c9d7449fce60754c07275",
            "web": "1:599792752048:web:4eff741470f9fb75c07275"
          }
        }
      }
    }
  },
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
